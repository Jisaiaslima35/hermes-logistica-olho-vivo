{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.fleetbase.automacaojs.us/schemas/parada.prolongada.schema.json",
  "title": "ParadaProlongadaPayload",
  "type": "object",
  "required": [
    "ordem_servico_id",
    "veiculo_id",
    "parada_id",
    "inicio",
    "duracao_s",
    "limiar_s"
  ],
  "properties": {
    "ordem_servico_id": { "type": "string" },
    "veiculo_id": { "type": "string" },
    "parada_id": { "type": "string" },
    "inicio": { "type": "string", "format": "date-time" },
    "fim": { "type": "string", "format": "date-time" },
    "duracao_s": { "type": "number" },
    "limiar_s": { "type": "number", "default": 900 },
    "local": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "endereco": { "type": "string" },
        "endereco_fonte": { "type": "string" }
      }
    },
    "motivo_declarado": { "type": "string" },
    "motorista_confirmou": { "type": "boolean" }
  }
}
